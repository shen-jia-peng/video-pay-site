<% active='videos'; %>
<div class="card">
  <h3>添加新视频</h3>
  <form method="POST" action="/admin/videos" enctype="multipart/form-data">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div class="form-group"><label>标题</label><input name="title" required placeholder="视频标题"></div>
      <div class="form-group"><label>价格 (元)</label><input name="price" type="number" step="0.01" placeholder="留空用站点默认"></div>
    </div>
    <div class="form-group"><label>简介</label><textarea name="desc" rows="2" placeholder="视频简介"></textarea></div>
    <div class="form-group"><label>视频地址（URL）</label><input name="videoUrl" placeholder="https://... 或本地路径，留空用示例视频"></div>
    <div class="form-group"><label>封面图（可选）</label><input name="coverFile" type="file" accept="image/*"></div>
    <button class="btn">添加视频</button>
  </form>
</div>
<div class="card">
  <h3>视频列表</h3>
  <table>
    <tr><th>标题</th><th>价格</th><th>添加时间</th><th>操作</th></tr>
    <% videos.forEach(function(v){ %>
      <tr>
        <td><%= v.title %></td>
        <td>¥ <%= (v.price||0).toFixed(2) %></td>
        <td><%= new Date(v.createdAt).toLocaleDateString() %></td>
        <td>
          <a class="btn btn-sm" href="/video/<%= v.id %>" target="_blank">预览</a>
          <form method="POST" action="/admin/videos/<%= v.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除？')">
            <button class="btn btn-sm btn-danger">删除</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
