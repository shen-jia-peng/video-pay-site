<% active='dashboard'; %>
<div class="stats">
  <div class="stat"><div class="n"><%= videos.length %></div><div class="l">视频总数</div></div>
  <div class="stat"><div class="n"><%= paidCount %></div><div class="l">已支付订单</div></div>
  <div class="stat"><div class="n">¥ <%= income.toFixed(2) %></div><div class="l">累计收入</div></div>
</div>
<div class="card">
  <h3>快捷操作</h3>
  <p style="font-size:13px;color:#666">
    <a class="btn btn-sm" href="/admin/videos">+ 添加视频</a>
    <a class="btn btn-sm btn-success" href="/admin/orders" style="margin-left:8px">查看订单</a>
    <a class="btn btn-sm" href="/admin/settings" style="margin-left:8px">站点/收款码设置</a>
  </p>
  <hr style="margin:16px 0;border:none;border-top:1px solid #eee">
  <p style="font-size:13px;color:#888">💡 提示：观众使用个人微信扫码支付后，请到"订单管理"核实收款并将对应订单标记为"已支付"，观众即可观看。</p>
  <% if (typeof pwd!=='undefined'&&pwd){ %><div class="alert" style="margin-top:14px;background:#e6f7ec;color:#07c160;border:1px solid #b7e8c4">密码已修改成功</div><% } %>
</div>
<div class="card">
  <h3>最近订单</h3>
  <table>
    <tr><th>订单号</th><th>用户</th><th>视频</th><th>金额</th><th>状态</th></tr>
    <% orders.slice(0,8).forEach(function(o){ %>
      <tr>
        <td><%= o.id.slice(-8) %></td>
        <td><%= o.userName %></td>
        <td><%= o.videoId %></td>
        <td>¥ <%= (o.amount||0).toFixed(2) %></td>
        <td><span class="badge <%= o.status==='paid'?'badge-paid':'badge-pending' %>"><%= o.status==='paid'?'已支付':'待支付' %></span></td>
      </tr>
    <% }) %>
  </table>
</div>
